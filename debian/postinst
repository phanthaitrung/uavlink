#!/bin/sh
set -e

# Installing never changes the running system. The only thing done here: after the very first install typed by
# hand on a terminal, open the setup page. This must never make the installation fail.

typed_by_hand() {
    [ "${DEBIAN_FRONTEND:-}" != "noninteractive" ] || return 1
    [ -z "${UAVLINK_NO_SETUP:-}" ] || return 1
    # The worker is "…/usr/bin/unattended-upgrade"; the always-running helper "unattended-upgrade-shutdown" must not match.
    if command -v pgrep >/dev/null 2>&1 && pgrep -f '/usr/bin/unattended-upgrade( |$)' >/dev/null 2>&1; then return 1; fi
    [ -t 1 ] || [ -t 0 ] || return 1
    return 0
}

case "$1" in
    configure)
        install -d -m 0755 /etc/uavlink
        install -d -m 0700 /var/lib/uavlink
        if [ -z "${2:-}" ]; then
            if typed_by_hand && [ ! -e /etc/uavlink/config.env ]; then
                uavlink setup --postinst || true
            fi
        elif [ -d /run/systemd/system ]; then
            # Upgrade: a running setup server is restarted on the new code, a stopped one stays stopped.
            systemctl daemon-reload || true
            deb-systemd-invoke try-restart uavlink-setup.service || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
