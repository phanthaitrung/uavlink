# =============================================================================
# Cấu hình chung cho bộ cài CM5 + CUAV X25 EVO + VPS relay.
#
# Giá trị mặc định là hệ thống đang chạy (22-23/10/2026, xem CHAT_SESSION_LOG.md).
# Mọi script đều đọc tệp này. Sửa ở đây rồi chạy lại `bash deploy.sh ...`.
# Mật khẩu, authkey: để trong secrets.env (chép từ secrets.env.example),
# giá trị trong secrets.env ghi đè giá trị cùng tên ở đây.
# =============================================================================

# ---- Máy điều hành: tên Host trong ~/.ssh/config --------------------------------
CM5_SSH=cm5
VPS_SSH=vps-mavlink             # để trống nếu không dùng VPS

# ---- CM5 ------------------------------------------------------------------------
CM5_USER=pi
CM5_ETH_IFACE=eth0              # cổng LAN nối X25 (xem `ip -br link`)
CM5_ETH_CON_NAME=x25-link       # tên kết nối NetworkManager
CM5_LAN_IP=192.168.50.2         # IP của CM5 trên dây LAN, X25 gửi MAVLink tới đây
# Địa chỉ phụ trên cùng cổng LAN. 192.168.144.x là dải mặc định của ArduPilot,
# giữ để CM5 vẫn với tới một X25 chưa được cấu hình.
CM5_ETH_EXTRA_ADDRS="192.168.144.2/24"
CM5_TCP_SERVER_PORT=5760        # TCP server của mavlink-router trên CM5
# Các đích UDP khác nhận MAVLink từ CM5, dạng "ten=ip:cong", cách nhau bằng dấu cách.
# Mặc định: máy văn phòng qua Tailscale. Để trống nếu không cần.
CM5_EXTRA_UDP_TARGETS="ground_station_office=100.70.184.3:14550"
CM5_ROUTER_LOG_DIR=/var/log/mavlink-router   # để trống để tắt ghi log chuyến bay
CM5_ROUTER_LOG_MODE=while-armed              # while-armed | always
CM5_DISABLE_MODEMMANAGER=1      # 1 = tắt ModemManager để không chiếm cổng USB của X25
MAV_VENV="/home/$CM5_USER/mavvenv"   # venv Python có pymavlink

# ---- CUAV X25 EVO (ArduCopter) ---------------------------------------------------
X25_IP=192.168.50.1
X25_NETMASK=24
X25_GATEWAY=0.0.0.0
X25_SERIAL=auto                 # auto = tự tìm /dev/serial/by-id/*ArduPilot*-if00
X25_BAUD=115200
X25_BACKUP_DIR="~/x25-backups"  # nơi lưu bản sao lưu tham số trên CM5
MAVLINK_LAN_PORT=14550          # NET_P1_PORT: cổng UDP trên CM5 mà X25 gửi tới

# ---- VPS relay -------------------------------------------------------------------
# CM5 gửi MAVLink tới IP này. Để trống = không đẩy lên VPS (chỉ dùng LAN/Tailscale).
VPS_PUBLIC_IP=209.97.167.92
VPS_DOMAIN=mav.dgp.vn           # để trống nếu không có tên miền (tắt luôn HTTPS)
VPS_UPLINK_PORT=14555           # VPS nhận MAVLink từ CM5 ở cổng UDP này
VPS_GCS_TCP_PORT=5760           # cổng TCP cho Mission Planner / QGC
VPS_GCS_UDP_PORT=14550          # cổng UDP cho Mission Planner / QGC
VPS_INSTALL_WEB=1               # 1 = cài Web Admin (thư mục web-admin/)
# Bản Web Admin: python = FastAPI (web-admin/app.py, /opt/mavweb)
#                typescript = Node.js (web-admin/ts, /opt/mavweb-ts). Cùng API, cùng giao diện,
#                cùng bộ đệm tham số; đổi qua lại chỉ cần sửa dòng này rồi chạy lại deploy.sh vps.
WEB_BACKEND=python
NODE_VERSION=24.22.1            # Node.js LTS cho WEB_BACKEND=typescript (tải từ nodejs.org, kiểm SHA-256)
VPS_INSTALL_NGINX=1             # 1 = Nginx reverse proxy trước Web Admin
VPS_ENABLE_TLS=1                # 1 = xin chứng chỉ Let's Encrypt cho VPS_DOMAIN
LETSENCRYPT_EMAIL=""            # để trống = đăng ký không kèm email
WEB_PORT=8000                   # cổng nội bộ của Web Admin (chỉ nghe 127.0.0.1)
WEB_PIP_PACKAGES="fastapi==0.158.2 uvicorn==0.54.0 websockets==17.3 pymavlink==2.4.50"   # WEB_BACKEND=python

# ---- DigitalOcean (chỉ dùng cho vps/create-droplet.sh) --------------------------
DO_DROPLET_NAME=vps-mavlink
DO_REGION=sgp1
DO_IMAGE=ubuntu-24-04-x64
DO_SIZE=s-1vcpu-1gb             # 6 USD/tháng
DO_SSH_KEY_IDS="60272440,60272442"
DO_PROJECT_ID=b700c19a-436a-4c62-b946-3dc678de8377   # project GENERAL
# Vùng DNS quản lý trên DigitalOcean để tự tạo bản ghi A. dgp.vn đang dùng
# nameserver Cloudflare nên để trống và sửa bản ghi trên Cloudflare.
DO_DNS_ZONE=""

# ---- Phần mềm --------------------------------------------------------------------
MAVLINK_ROUTER_REPO=https://github.com/mavlink-router/mavlink-router.git
# Commit đã chạy thật trên CM5 và VPS (mavlink-routerd --version: v4-16-g2362c62)
MAVLINK_ROUTER_REF=2362c620f483cef1edd574fb962a373a288e4b9e
# true = in thống kê mỗi vài giây vào journal (bật khi cần chẩn đoán)
ROUTER_REPORT_STATS=false
PYMAVLINK_VERSION=2.4.50
PYSERIAL_VERSION=3.5

# ---- Chuẩn bị CM5 mới cài (cm5/bootstrap-cm5.sh, chạy tại chỗ) ------------------
CM5_SUDO_NOPASSWD=1             # sudo không cần mật khẩu cho CM5_USER
CM5_INSTALL_TAILSCALE=1
CM5_TS_HOSTNAME=cm5
CM5_WIFI_IFACE=wlan0
CM5_WIFI_SSID=""                # để trống = không đổi Wi-Fi; mật khẩu ở secrets.env

# ---- Bảo mật ---------------------------------------------------------------------
# MAVLink2 signing: X25 chỉ nhận lệnh có chữ ký bằng MAVLINK_SIGNING_PASSPHRASE (secrets.env,
# deploy.sh tự sinh nếu trống). GCS không có passphrase vẫn xem telemetry nhưng không gửi lệnh,
# không tải tham số được. Cáp USB luôn được miễn. 0 = không đụng tới cấu hình ký trên mạch bay.
MAVLINK_SIGNING=1
# Web Admin bắt đăng nhập Basic Auth. Mật khẩu WEB_BASIC_AUTH_PASS ở secrets.env (tự sinh nếu trống).
WEB_AUTH=1
WEB_BASIC_AUTH_USER=admin
SSH_HARDEN=1                    # CM5 + VPS: SSH chỉ đăng nhập bằng khóa, root không dùng mật khẩu
# Tường lửa CM5: Wi-Fi/LAN nhà chỉ mở SSH (CM5_SSH_ALLOW_LAN=1); MAVLink chỉ nhận từ dây LAN
# nối X25 và từ Tailscale.
CM5_ENABLE_UFW=1
CM5_SSH_ALLOW_LAN=1             # 0 = SSH chỉ qua Tailscale
# Tường lửa VPS: chỉ mở SSH, 80, 443, cổng nhận từ CM5 và cổng GCS. Mỗi lần bộ luật đổi,
# toàn bộ luật UFW cũ bị xoá và đặt lại.
VPS_ENABLE_UFW=1
# Nguồn được vào cổng GCS (TCP/UDP) trên VPS: "any" hoặc danh sách IP/CIDR cách nhau bằng dấu cách.
VPS_GCS_ALLOW_FROM="any"
VPS_FAIL2BAN=1                  # chặn IP dò mật khẩu SSH / Web Admin
# Chạy mavlink-router và Web Admin bằng user riêng, không root, giới hạn bằng systemd.
# Đặt 0 nếu cần thêm endpoint serial (/dev/tty*) cho mavlink-router.
SERVICE_SANDBOX=1
# Thay đổi tường lửa/SSH tự hoàn tác sau chừng này giây nếu không có kết nối SSH mới xác nhận
# (deploy.sh tự xác nhận ngay khi cài xong).
FIREWALL_ROLLBACK_SECS=180

# ---- Bí mật: đặt trong secrets.env, KHÔNG điền ở đây -------------------------------
WEB_BASIC_AUTH_PASS=""
MAVLINK_SIGNING_PASSPHRASE=""   # chỉ chữ, số và . _ - ; tối thiểu 12 ký tự
TS_AUTHKEY=""                   # Tailscale auth key; trống = tailscale in URL để đăng nhập
CM5_WIFI_PSK=""
