# CM5 settings pointing at a local fake VPS (never the real one), for trying engine/tools/net_probe.py by hand:
#   <mavlink-routerd> -c tests/fixtures/net-fake-vps/vps.conf -d /nonexistent &
#   tools/wsl.sh env UAVLINK_EVENTS=1 UAVLINK_CONFIG_DIR=tests/fixtures/net-fake-vps python3 engine/tools/net_probe.py
# The ports match vps.conf; tests/test_net_probe.py checks that.
UAVLINK_ROLE='cm5'
X25_IP='127.0.0.1'
MAVLINK_LAN_PORT='24550'
CM5_TCP_SERVER_PORT='25761'
CM5_ETH_IFACE='eth0'
CM5_EXTRA_UDP_TARGETS=''
CM5_INSTALL_TAILSCALE='0'
VPS_PUBLIC_IP='127.0.0.1'
VPS_UPLINK_PORT='24555'
VPS_GCS_TCP_PORT='25760'
VPS_GCS_UDP_PORT='24551'
MAVLINK_SIGNING='0'
